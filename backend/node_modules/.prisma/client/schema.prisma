// ─── Prisma Schema — ZipRide MVP ────────────────────────────────────────────
// Banco: PostgreSQL
// Para aplicar: npx prisma migrate dev --name init
// Para visualizar: npx prisma studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuários ─────────────────────────────────────────────────────────────────
model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String?
  password   String
  role       String   @default("user") // "user" | "admin"
  balance    Float    @default(20.0)
  totalRides Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rides Ride[]

  @@map("users")
}

// ─── Zonas de geofencing ──────────────────────────────────────────────────────
model Zone {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#3B82F6")
  radius    Int // metros
  centerLat Float
  centerLng Float
  createdAt DateTime @default(now())

  hubs Hub[]

  @@map("zones")
}

// ─── Hubs (pontos fixos) ──────────────────────────────────────────────────────
model Hub {
  id       String  @id @default(uuid())
  name     String
  lat      Float
  lng      Float
  capacity Int     @default(4)
  zoneId   String?
  zone     Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  scooters Scooter[]

  @@map("hubs")
}

// ─── Patinetes ────────────────────────────────────────────────────────────────
model Scooter {
  id            String   @id // ex: "SCT-001"
  name          String
  model         String   @default("Segway Ninebot E2")
  status        String   @default("available") // available | in_use | offline | maintenance
  locked        Boolean  @default(true)
  battery       Float    @default(100)
  lat           Float
  lng           Float
  totalRides    Int      @default(0)
  hubId         String?
  hub           Hub?     @relation(fields: [hubId], references: [id], onDelete: SetNull)
  currentRideId String? // ID da corrida ativa (denormalizado para performance)
  lastUpdate    DateTime @default(now())
  createdAt     DateTime @default(now())

  rides Ride[]

  @@map("scooters")
}

// ─── Corridas ─────────────────────────────────────────────────────────────────
model Ride {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  scooterId   String
  scooter     Scooter   @relation(fields: [scooterId], references: [id])
  startTime   DateTime  @default(now())
  endTime     DateTime?
  startLat    Float
  startLng    Float
  endLat      Float?
  endLng      Float?
  cost        Float?
  status      String    @default("active") // active | completed | cancelled
  unlockFee   Float     @default(3.0)
  pricePerMin Float     @default(0.5)
  nearestHub  String?

  @@map("rides")
}
