# ─── ZipRide MVP — Variáveis de Ambiente ─────────────────────────────────────
# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# ─── Banco de dados PostgreSQL ────────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Instalação local (Windows):
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/zipride"
#
# Neon (cloud gratuito - recomendado para produção):
# DATABASE_URL="postgresql://user:pass@ep-xxxxx.us-east-1.aws.neon.tech/zipride?sslmode=require"
#
# Supabase:
# DATABASE_URL="postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="zipride-secret-mude-em-producao-2024"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
